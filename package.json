{
  "name": "ilkkan-sports",
  "version": "1.0.0",
  "private": true,
  "description": "İlkkan Sports — Gibi temalı canlı spor sitesi ve yönetim paneli",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "admin": "node --env-file-if-exists=.env server/cli/create-admin.js",
    "test": "node --test --experimental-test-coverage --test-coverage-include=server/**/*.js tests/*.test.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0"
  }
}

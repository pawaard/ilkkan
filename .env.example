# Kopyala: .env  — gerçek değerleri .env içine yaz, .env git'e girmez
PORT=5500
# Sitenin yayındaki adresi (SEO: canonical, sitemap, paylaşım kartları).
# https:// ile başlıyorsa oturum çerezi yalnızca HTTPS'te gider ve HSTS açılır.
SITE_URL=http://localhost:5500
# production: şablonlar ve sürüm etiketi önbellekte tutulur
NODE_ENV=development
# Paneli ayrı alan adından aç (önerilir, özellikle reklam kodu kullanıyorsan): ör. reji.alanadin.com
# Ayarlıysa /yonetim yalnızca bu alan adında çalışır, site alan adında 404 döner.
ADMIN_HOST=
# Veritabanı dosyası (yayında kalıcı diskte olmalı)
DB_PATH=data/ilkkan.db
# Panelden yüklenen görsellerin klasörü (boşsa public/uploads; yayında kalıcı diskte olmalı)
UPLOAD_DIR=
# Nginx / Caddy / Render gibi bir ters vekil arkasındaysan 1 yap (gerçek ziyaretçi IP'si için).
# 1 = yalnızca yerel/özel ağdaki vekile güven. Vekil dışarıda başka bir sunucudaysa onun ağını yaz (ör. 10.0.0.0/8).
TRUST_PROXY=0
# İlk yönetici (yalnızca hiç yönetici yokken, ilk açılışta oluşturulur; sonra silebilirsin)
ADMIN_USER=
ADMIN_PASSWORD=
